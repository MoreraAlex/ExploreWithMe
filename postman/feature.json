              "  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;",
              "}",
              "pm.collectionVariables.set('draftEventDate', formatDate(new Date(Date.now() + 6 * 60 * 60 * 1000)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Draft event created', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('draftEventId', json.id);",
              "pm.test('Draft event is PENDING', function () { pm.expect(json.state).to.eql('PENDING'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"annotation\":\"Draft rating annotation with enough length.\",\"category\":{{categoryId}},\"description\":\"Draft rating description with enough length for validation.\",\"eventDate\":\"{{draftEventDate}}\",\"location\":{\"lat\":55.76,\"lon\":37.62},\"paid\":false,\"participantLimit\":0,\"requestModeration\":true,\"title\":\"Draft rating event\"}"
        },
        "url": {
