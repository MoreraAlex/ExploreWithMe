        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Event published', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Published event still has zero rating', function () {",
              "  pm.expect(json.state).to.eql('PUBLISHED');",
              "  pm.expect(json.likes).to.eql(0);",
              "  pm.expect(json.dislikes).to.eql(0);",
              "  pm.expect(json.rating).to.eql(0);",
              "});"
            ]
          }
        }
      ]
