    {
      "name": "Setup / Create event",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function formatDate(date) {",
              "  const pad = n => String(n).padStart(2, '0');",
              "  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;",
              "}",
              "pm.collectionVariables.set('eventDate', formatDate(new Date(Date.now() + 5 * 60 * 60 * 1000)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Event created', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('eventId', json.id);",
              "pm.test('New event has zero rating fields', function () {",
              "  pm.expect(json.likes).to.eql(0);",
              "  pm.expect(json.dislikes).to.eql(0);",
              "  pm.expect(json.rating).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"annotation\":\"Rating feature annotation with enough length.\",\"category\":{{categoryId}},\"description\":\"Rating feature description with enough length for validation.\",\"eventDate\":\"{{eventDate}}\",\"location\":{\"lat\":55.75,\"lon\":37.61},\"paid\":false,\"participantLimit\":0,\"requestModeration\":true,\"title\":\"Rating feature event\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{ownerId}}/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{ownerId}}",
            "events"
          ]
        }
      }
    },
    {
      "name": "Setup / Publish event",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
